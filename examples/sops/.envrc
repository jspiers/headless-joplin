# The Joplin profile config is encrypted in-repo (see .sops.yaml) and handed to
# docker compose base64-encoded, so it never exists as a plaintext file on
# either this machine or the Docker daemon's host.
if ! _joplin_config="$(sops decrypt secrets/joplin-config.sops.json)"; then
  log_error "could not decrypt secrets/joplin-config.sops.json (missing ~/.config/sops/age/keys.txt?)"
  return 1
fi

export JOPLIN_CONFIG_JSON_B64="$(printf '%s' "$_joplin_config" | base64 | tr -d '\n')"
unset _joplin_config
